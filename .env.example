# Copy to .env.local and fill in. NEVER commit .env.local or any real key.

# Server only. The treasury keypair that pays the "Fund for testing" airdrop (Phase 6), as a JSON
# array of bytes: [12,34,...]. Keep it funded with devnet SOL only.
FUNDING_KEY=

# Optional overrides (defaults are the MagicBlock devnet endpoints in packages/sdk/src/constants.ts).
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_ROLLUP_URL=

# The machine authority's public key; identifies which machine the app talks to.
NEXT_PUBLIC_MACHINE_AUTHORITY=

# Set to 1 to show the QA states menu (it is always off in production builds).
NEXT_PUBLIC_QA=
